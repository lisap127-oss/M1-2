# ===== 백엔드 환경 변수 예시 =====
# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 절대 커밋하지 마세요)

# OpenAI
OPENAI_API_KEY=sk-여기에_본인_키
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# Firebase 서비스 계정 (아래 둘 중 하나만 설정)
# 방식 1) 키 JSON 내용을 한 줄 문자열로 통째로 붙여넣기 (Render 배포에 권장)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# 방식 2) 키 파일 경로 (로컬 개발용). 위 방식1을 쓰면 이 줄은 비워둡니다.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# CORS 허용 도메인 (쉼표 구분). 로컬 + 배포된 프론트 주소를 넣습니다.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend.vercel.app
